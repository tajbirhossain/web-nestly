# Neon connection strings. `npx neon env pull` writes these to .env.local for you.
# Leave blank to run on built-in sample data (admin edits then stay in the browser).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (listing photo uploads). Create a Blob store in the Vercel project, then `npx vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# Email (Resend). Without these, emails are skipped and only logged.
RESEND_API_KEY=
EMAIL_FROM=

# Public site URL for the sitemap and links in emails (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=
